<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CommonScreens">

        <activity
            android:name="com.example.commonscreens.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.commonscreens.LoginActivity"
            android:exported="false" />

        <activity
            android:name="com.example.commonscreens.RegisterActivity"
            android:exported="false" />

        <activity
            android:name="com.example.commonscreens.ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name="com.example.commonscreens.ResetPasswordActivity"
            android:exported="false" />

        <activity
            android:name="com.example.commonscreens.DashboardActivity"
            android:exported="false" />

        <activity
            android:name="com.example.commonscreens.ProfileActivity"
            android:exported="false" />

    </application>

</manifest>
