<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme: Material DayNight follows the system light/dark setting.
         Colors come from colors.xml, so night mode works automatically. -->
    <style name="Theme.CommonScreens" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>
</resources>